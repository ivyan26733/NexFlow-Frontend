# Copy this file to .env.local and fill in your values
# .env.local is gitignored and should never be committed

# URL of the Nexflow backend API (Spring Boot)
# Local development: http://localhost:8090
# Production (AWS EC2): http://<your-ec2-public-ip-or-domain>:8090
#   OR if behind nginx on port 80: http://<your-ec2-public-ip-or-domain>
NEXT_PUBLIC_API_URL=http://localhost:8090

# WebSocket URL for live execution events in Studio
# Local development: http://localhost:8090/ws
# Production: same backend URL with /ws appended
NEXT_PUBLIC_WS_URL=http://localhost:8090/ws
